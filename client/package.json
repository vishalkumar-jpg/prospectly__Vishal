{
  "name": "prospectly-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run server/index.ts",
    "dev:spa": "vite",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "build:dev": "vite build --mode development && vite build --ssr src/entry-server.tsx --outDir dist/server",
    "preview": "NODE_ENV=production bun run server/index.ts",
    "prod": "NODE_ENV=production bun run server/index.ts",
    "prettier": "prettier src --check",
    "prettier:fix": "prettier src --write",
    "format": "prettier --write 'src/**/*.{ts,tsx,js,jsx,json,css,md}'",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint-staged": "lint-staged",
    "prepare": "cd .. && git config core.hooksPath client/.husky || true"
  },
