## API Design

### RESTful Conventions

- POST `/module-name` - Create
- GET `/module-names` - Get all with the query params which are defined in the `ModuleNameQueryDto` class.
- GET `/module-name/:id` - Get by ID
- GET `/module-name/by-field/:value` - Get by specific field
- PUT `/module-name/:id` - Update
- DELETE `/module-name` - Bulk delete with body `{ ids: string[] }`

### Response Format

```typescript
// Success response
{
  data: T,
  status: number
}

// Error response
{
  statusCode: number,
  message: string,
  errors?: Array<{ row: number; errorMessages: string[] }>
}
```

## Controller Implementation

### Structure

```typescript
@ApiTags("Module Name")
@Controller("module-name")
@UseGuards(UserAuthGuard)
export class ModuleNameController {
  constructor(private readonly moduleNameService: ModuleNameService) {}

  @ApiSwaggerResponse(ResponseType)
  @Post()
  async create(@CurrentUser() { id }: ReqUser, @Body() createDto: CreateModuleNameDto, @Res() res: Response) {
    try {
      const data = await this.moduleNameService.create(id, createDto);
      return responseUtils.success(res, { data });
    } catch (error) {
      logger.error(`CONTROLLER :: METHOD :: ERROR :: ${metaType.Json}`, error);
      return responseUtils.error({ res, error });
    }
  }
}
```

### Best Practices

- Use `@ApiTags()` for Swagger grouping
- Include `@UseGuards(UserAuthGuard)` for authentication
- Use `@ApiSwaggerResponse()` custom decorator for Swagger documentation
- Use `responseUtils.success()` and `responseUtils.error()` for consistent responses from the custom response utils file in `src/utils/response.utils.ts`
- Include proper error logging in controllers
- (if applicable): Use `@CurrentUser()` decorator for user context (e.g., `@CurrentUser() { id }: ReqUser`)

## Service Implementation

### Structure

```typescript
@Injectable()
export class ModuleNameService {
  constructor(
    @InjectRepository(ModuleNameEntity)
    private readonly moduleNameRepository: Repository<ModuleNameEntity>,
    private readonly validateService: ModuleNameValidateService,
    private readonly databaseService: DatabaseService,
  ) {}

  /**
   * Create a new entity
   * @param userId - The user ID
   * @param createDto - The create DTO
   * @returns The created entity
   */
  async createModuleName(userId: string, createDto: CreateModuleNameDto): Promise<MessageResponse> {
    const queryRunner = await this.databaseService.createQueryRunner();

    try {
      // Validation
      await this.validateService.validateRelations(createDto, queryRunner);

      // Business logic with transaction
      const result = await queryRunner.manager.save(entity, { data: { userId } });

      await queryRunner.commitTransaction();
      return { message: MODULE_NAME_MESSAGES.INFO.CREATED };
    } catch (error) {
      await queryRunner.rollbackTransaction();
      logger.error(`SERVICE :: METHOD :: ERROR :: ${metaType.Json}`, error);
      throw new BadRequestException(error.message);
    } finally {
      await queryRunner.release();
      logger.info(`SERVICE :: METHOD :: releasing database connection`);
    }
  }

  /**
   * Update an entity
   * @param id - The entity ID
   * @param updateDto - The update DTO
   * @returns The updated entity
   */
  async updateModuleName(id: string, updateDto: UpdateModuleNameDto): Promise<MessageResponse> {
    const record = await this.moduleNameRepository.createQueryBuilder("moduleName").where({ id }).getOne();

    if (!record) {
      throw new NotFoundException(MODULE_NAME_MESSAGES.ERROR.NOT_FOUND);
    }
    await this.moduleNameRepository.update(id, updateDto);

    return { message: MODULE_NAME_MESSAGES.INFO.UPDATED };
  }

  /**
   * Find all entities with filters, sorting, and pagination
   * @param query - The query DTO
   * @returns The entities and pagination details
   */
  async findModuleNames(query: ModuleNameQueryDto): Promise<ResponseDto<ModuleNameListResponse>> {
    const { page = 1, limit = 20, sort = "createdAt", order = "DESC", search, isPagination = true, id } = query;

    const qb = this.moduleNameRepository.createQueryBuilder("moduleName");

    // Search (example: search by name or description)
    if (search) {
      qb.andWhere("(moduleName.name ILIKE :search OR moduleName.description ILIKE :search)", { search: `%${search}%` });
    }

    // Filter by ID
    if (id) {
      qb.andWhere("moduleName.id = :id", { id });
    }

    // Sorting
    qb.orderBy(`moduleName.${sort}`, order.toUpperCase() === "ASC" ? "ASC" : "DESC");

    // Pagination
    if (isPagination) {
      qb.skip((page - 1) * limit).take(limit);
    }

    // Execute query
    const [data, total] = await qb.getManyAndCount();

    return {
      data: transformToInstance(ModuleNameResponse, data),
      total,
      page: isPagination ? page : 1,
      limit: isPagination ? limit : total,
      totalPages: isPagination ? Math.ceil(total / limit) : 1,
    };
  }

  async deleteModuleNames(ids: string[]): Promise<MessageResponse> {
    const records = await this.moduleNameRepository
      .createQueryBuilder("moduleName")
      .where({ id: In(ids) })
      .getMany();

    if (!records.length) {
      return true;
    }

    await this.moduleNameRepository.softRemove(records);

    return { message: MODULE_NAME_MESSAGES.INFO.DELETED };
  }
}
```

#### Notes:

- Provide proper comments for the service methods. Use `/** */` for the comments. Also include the example logic with sample data in the comments.
- Maintain return type for the service methods.
- `ModuleNameQueryDto` should define `page`, `limit`, `sort`, `order`, `search`, `isPagination`, `id` fields.
- Adjust search logic as per your entity fields and requirements.
- `transformToInstance` is a helper function to transform the data to the response type based on the response class `ModuleNameResponse` defined inside the `module-name.response.ts` file.
- `MessageResponse` is a custom response type defined inside the `modules/swagger/dtos/response.dtos.ts` file.
- Include proper logs for debugging and error handling in the service methods where needed.

## Validation Service Implementation

### Structure

```typescript
@Injectable()
export class ModuleNameValidateService {
  constructor(
    private readonly validationService: ValidationService,
    @InjectRepository(ModuleNameEntity)
    private readonly moduleNameRepository: Repository<ModuleNameEntity>,
  ) {}

  async validateRelation(id: string, shouldThrow: boolean = true, queryRunner?: QueryRunner) {
    const repository = queryRunner ? queryRunner.manager.getRepository(RelatedEntity) : this.moduleNameRepository;

    const record = await repository.createQueryBuilder("alias").where("alias.id = :id", { id }).getOne();

    if (!record && shouldThrow) {
      throw new NotFoundException(MESSAGES.ERROR.RELATED_NOT_FOUND);
    }

    return record;
  }

  async validateUniqueField(value: string, queryRunner: QueryRunner, excludeId?: string) {
    const repository = queryRunner.manager.getRepository(ModuleNameEntity);

    return this.validationService.isExists({
      repo: repository,
      name: "fieldName",
      value,
      excludeId,
    });
  }
}
```

#### Notes:

- ValidationService is a custom service for validation which is defined inside the `src/services/validation.service.ts` file.

