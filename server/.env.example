# Application Environment
NODE_ENV=
PORT=
WORKER_PORT=

# Frontend / Backend URLs
FRONTEND_URL=
API_URL=

# CORS Configuration (comma-separated list of allowed origins)
CORS_ORIGINS=

# PostgreSQL Database (Used if DATABASE_URL is not provided)
DATABASE_URL=

# Redis Configuration
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=
REDIS_URL=

# Auth / Security Secrets
JWT_SECRET=
UNSUBSCRIBE_SECRET=
REFRESH_TOKEN_SECRET=
ENCRYPTION_KEY=

# Google OAuth / Calendar Integration
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Redirects (Frontend handling URLs)
GOOGLE_AUTH_REDIRECT_URI=
GOOGLE_CALENDAR_REDIRECT_URI=

# Microsoft OAuth Integration
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_AUTH_REDIRECT_URI=

# Stripe Payment Integration
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Stripe Global Payouts (v2 Money Management, preview)
# Platform Financial Account (USD) that funds outbound payouts — from
# Dashboard > Payout settings, or v2 money_management/financial_accounts.
STRIPE_FINANCIAL_ACCOUNT_ID=
# Signing secret for the v2 "thin event" webhook endpoint (/webhooks/stripe/v2)
STRIPE_V2_WEBHOOK_SECRET=

# Resend (Email Provider) Configuration
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_WEBHOOK_SECRET=

# AWS S3 / CloudFront Configuration
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_CLOUDFRONT_URL=
AWS_MEDIA_URL=

# Signed URL Expiry (in seconds)
AWS_SIGNED_URL_EXPIRATION=

# Queues / Background Jobs
ENABLE_QUEUES=

# Monitoring / Error Tracking
SENTRY_DSN=

COOKIE_DOMAIN=.example.com
CORS_ORIGINS=https://example.com
X_API_KEY=

TYPESENSE_API_KEY=
TYPESENSE_HOST=

# Apollo.io Integration
APOLLO_API_KEY=
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_TIMEOUT_MS=15000

# IP Geolocation — country auto-detect for the profile-completion gate.
IPINFO_TOKEN=
IPINFO_BASE_URL=https://api.ipinfo.io
IPINFO_TIMEOUT_MS=3000
