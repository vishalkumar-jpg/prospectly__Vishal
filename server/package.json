{
  "name": "prospectly-server",
  "private": true,
  "version": "0.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "nest start --watch",
    "dev:nest": "nest start --watch",
    "dev:nest:debug": "nest start --debug --watch",
    "build": "nest build",
    "build:prod": "nest build && tsc-alias",
    "start": "node dist/src/main",
    "start:prod": "node dist/src/main",
    "start:nest": "node dist/src/main",
    "start:nest:prod": "node dist/src/main",
    "worker:dev": "sleep 15 && nest start --watch --entryFile worker",
    "worker:start": "node dist/src/worker",
    "worker:start:prod": "node dist/src/worker",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun test",
    "prepare": "cd .. && git config core.hooksPath server/.husky || true",
    "seed": "npx tsx ./src/database/seed/seed.ts",
    "seed:dev": "node dist/src/database/seed/seed.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.970.0",
    "@aws-sdk/s3-presigned-post": "^3.970.0",
    "@aws-sdk/s3-request-presigner": "^3.970.0",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "11.1.24",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.24",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "11.1.24",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.4",
    "@nestjs/throttler": "^6.4.0",
    "@sentry/node": "^10.37.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.65.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "date-fns": "^3.6.0",
    "dayjs": "^1.11.13",
    "disposable-email-domains": "^1.0.62",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "drizzle-seed": "^0.3.1",
    "drizzle-zod": "^0.8.3",
    "express": "^5.1.0",
    "googleapis": "^166.0.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pgvector": "^0.2.0",
    "postgres": "^3.4.7",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.4.2",
    "rxjs": "^7.8.2",
    "sanitize-html": "^2.17.0",
    "stripe": "^19.3.1",
    "typesense": "^3.0.3",
    "unpdf": "^1.8.0",
    "winston": "^3.19.0",
    "yauzl": "^3.2.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.2.0",
    "@commitlint/config-conventional": "^20.2.0",
    "@eslint/js": "^9.9.0",
    "@nestjs/cli": "11.0.21",
    "@nestjs/testing": "11.1.24",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.5.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/yauzl": "^2.10.3",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "drizzle-kit": "^0.31.7",
    "eslint": "^9.9.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "globals": "^15.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.3",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
